{
  "version": 1,
  "description": "Authoritative map of Bitbull Capital's agent workspaces, membership and write access.",
  "roles": {
    "ceo": {"title": "Chief Executive Officer", "reports_to": "founder", "workspaces": ["exec", "founder"]},
    "cfo": {"title": "Chief Financial Officer", "reports_to": "ceo", "workspaces": ["exec", "finance"]},
    "cost-optimizer": {"title": "Cost Optimizer", "reports_to": "cfo", "workspaces": ["finance"]},
    "cto": {"title": "Chief Technology Officer", "reports_to": "ceo", "workspaces": ["exec", "engineering"]},
    "clo": {"title": "Chief Legal Officer", "reports_to": "ceo", "workspaces": ["exec", "legal"]},
    "market-analyst": {"title": "Quantitative Analyst", "reports_to": "cfo", "workspaces": ["finance"]},
    "trader": {"title": "Execution Trader", "reports_to": "cfo", "workspaces": ["finance"]},
    "backend-developer": {"title": "Backend Developer", "reports_to": "cto", "workspaces": ["engineering"]},
    "frontend-developer": {"title": "Frontend Developer", "reports_to": "cto", "workspaces": ["engineering"]},
    "qa-tester": {"title": "QA Engineer", "reports_to": "cto", "workspaces": ["engineering"]}
  },
  "workspaces": {
    "exec": {"path": "workspaces/exec", "owner": "ceo", "members": ["ceo", "cfo", "cto", "clo"], "readers": [], "purpose": "C-suite coordination and founder communication."},
    "finance": {"path": "workspaces/finance", "owner": "cfo", "members": ["cfo", "cost-optimizer", "market-analyst", "trader"], "readers": [], "purpose": "Trading floor, research, cost optimization."},
    "engineering": {"path": "workspaces/engineering", "owner": "cto", "members": ["cto", "backend-developer", "frontend-developer", "qa-tester"], "readers": [], "purpose": "Engineering work and testing."},
    "legal": {"path": "workspaces/legal", "owner": "clo", "members": ["clo"], "readers": ["ceo"], "purpose": "Legal analysis and compliance."},
    "founder": {"path": "workspaces/founder", "owner": "ceo", "members": ["ceo"], "readers": [], "purpose": "Founder briefs and approvals."}
  },
  "write_rules": {
    "workspaces/finance/**": ["cfo", "cost-optimizer", "market-analyst", "trader"],
    "workspaces/exec/**": ["ceo", "cfo", "cto", "clo"]
  }
}
