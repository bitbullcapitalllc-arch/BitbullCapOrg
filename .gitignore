# Secrets — never commit credentials, API keys or account numbers (see CLAUDE.md)
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*
config.local.*

# Trading/runtime output that must not live in the repo
logs/
*.log
data/
*.csv
*.parquet

# ...but golden test fixtures are evidence, not output, and must be committed
# (CTO finding S2: `git add tests/fixtures/x.csv` silently added nothing)
!tests/fixtures/**

# ...and the negation above must not re-open the secrets hole (QA finding F1):
# later rules win, so re-ignore credential-shaped names inside fixtures too
tests/fixtures/**/.env
tests/fixtures/**/.env.*
tests/fixtures/**/*.pem
tests/fixtures/**/*.key
tests/fixtures/**/credentials*
tests/fixtures/**/secrets*
tests/fixtures/.env
tests/fixtures/.env.*
tests/fixtures/*.pem
tests/fixtures/*.key
tests/fixtures/credentials*
tests/fixtures/secrets*

# Python / Node / editor noise
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
.DS_Store
.ipynb_checkpoints/
